-------------------------------------------------------------------------------
-- LOCK HELPERS
-------------------------------------------------------------------------------
local function markSafe(p)
    if knownMines[p] then return end
    if knownSafe[p] and lockedSafe[p] then return end
    knownSafe[p]  = true
    lockedSafe[p] = true
    local h = p:FindFirstChild("Safe_Highlight")
    if not h then
        h = Instance.new("Highlight")
        h.Name="Safe_Highlight"; h.Adornee=p
        h.FillColor=Color3.new(0,1,0); h.FillTransparency=0.4
        h.OutlineTransparency=0.5; h.DepthMode=Enum.HighlightDepthMode.Occluded
        h.Parent=p
    end
    -- tier 1: queue neighbors for re-evaluation
    if neighborMap[p] then
        for _,nb in ipairs(neighborMap[p]) do
            if numberTiles[nb] and not inPropQueue[nb] then
                inPropQueue[nb] = true
                table.insert(propagationQueue, nb)
            end
        end
    end
end

local function markMine(p)
    if knownSafe[p] then return end
    if knownMines[p] and lockedMines[p] then return end
    knownMines[p]  = true
    lockedMines[p] = true
    local h = p:FindFirstChild("Mine_Highlight")
    if not h then
        h = Instance.new("Highlight")
        h.Name="Mine_Highlight"; h.Adornee=p
        h.FillColor=Color3.new(1,0,0); h.FillTransparency=0.4
        h.OutlineTransparency=0.5; h.DepthMode=Enum.HighlightDepthMode.Occluded
        h.Parent=p
    end
    -- tier 1: queue neighbors for re-evaluation
    if neighborMap[p] then
        for _,nb in ipairs(neighborMap[p]) do
            if numberTiles[nb] and not inPropQueue[nb] then
                inPropQueue[nb] = true
                table.insert(propagationQueue, nb)
            end
        end
    end
end

local function unmarkTile(p)
    knownSafe[p]=nil; knownMines[p]=nil
    lockedSafe[p]=nil; lockedMines[p]=nil
    for _,name in ipairs({"Mine_Highlight","Safe_Highlight","Guess_Highlight"}) do
        local h=p:FindFirstChild(name); if h then h:Destroy() end
    end
end

