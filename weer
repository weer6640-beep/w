fastBtn.MouseButton1Click:Connect(function()
    if not isScanning then return end
    isAutoTouching=not isAutoTouching
    if isAutoTouching then
        fastBtn.Text="AUTO TOUCH: ON"; fastBtn.TextColor3=Color3.fromRGB(100,255,100)
        status.Text="Status: Proximity Active"
        task.spawn(function()
            while isAutoTouching and isScanning do
                if not pendingReset then
                    local charPos=getCharPos()
                    refreshFlagCache()
                    -- remove misplaced flags on safe tiles
                    local misplaced={}
                    for part,_ in pairs(knownSafe) do
                        if part and part:IsDescendantOf(workspace) and hasFlag(part) then
                            table.insert(misplaced,part)
                        end
                    end
                    sortByProximity(misplaced,charPos)
                    for _,part in ipairs(misplaced) do
                        if not isAutoTouching or not isScanning or pendingReset then break end
                        clickTile(part); task.wait(0.02)
                    end
                    -- flag mines
                    local toFlag={}
                    for part,_ in pairs(knownMines) do
                        if part and part:IsDescendantOf(workspace) and not hasFlag(part) then
                            table.insert(toFlag,part)
                        end
                    end
                    sortByProximity(toFlag,charPos)
                    for _,part in ipairs(toFlag) do
                        if not isAutoTouching or not isScanning or pendingReset then break end
                        clickTile(part); task.wait(0.02)
                    end
                    -- reveal safe tiles
                    local safeToReveal={}
                    for part,_ in pairs(knownSafe) do
                        if part and part:IsDescendantOf(workspace)
                        and not hasFlag(part) and not touchBlacklist[part] then
                            table.insert(safeToReveal,part)
                        end
                    end
                    sortByProximity(safeToReveal,charPos)
                    if #safeToReveal>0 then
                        local bc=math.min(#safeToReveal,BATCH_SIZE)
                        for i=1,bc do
                            local part=safeToReveal[i]
                            task.spawn(function()
                                if isAutoTouching and isScanning and not pendingReset then
                                    triggerTileTouch(part)
                                end
                            end)
                        end
                        task.wait(0.04)
                    else
                        task.wait(0.06)
                    end
                else
                    task.wait(0.1)
                end
            end
            isAutoTouching=false
            fastBtn.Text="AUTO TOUCH: OFF"; fastBtn.TextColor3=Color3.fromRGB(100,220,255)
            if isScanning then status.Text="Status: Scanning..." end
        end)
    else
        isAutoTouching=false
        fastBtn.Text="AUTO TOUCH: OFF"; fastBtn.TextColor3=Color3.fromRGB(100,220,255)
        status.Text="Status: Scanning..."
    end
end)

