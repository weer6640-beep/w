    end
end

local function fullCleanup()
    isScanning=false; isAutoTouching=false; pendingReset=false
    for _,conn in pairs(connections) do if conn then conn:Disconnect() end end
    connections={}
    for _,part in ipairs(cachedParts) do
        if part and part:IsDescendantOf(workspace) then clearVisuals(part) end
    end
    cachedParts={}; neighborMap={}; numberTiles={}
    knownMines={}; knownSafe={}; lockedSafe={}; lockedMines={}
    touchBlacklist={}; probabilityMap={}
    currentBestGuess=nil; activeFlagPositions={}
    propagationQueue={}; inPropQueue={}
end

local function sortByProximity(list,charPos)
    if not charPos or #list<=1 then return end
    table.sort(list,function(a,b)
        return (a.Position-charPos).Magnitude < (b.Position-charPos).Magnitude
    end)
end

local function isColorMatch(c1,r,g,b)
    return math.abs(c1.R-r)<0.10 and math.abs(c1.G-g)<0.10 and math.abs(c1.B-b)<0.10
end

local function isExcluded(part)
    if not part:IsA("BasePart") then return true end
    if isColorMatch(part.Color,1,1,0.490) or isColorMatch(part.Color,0.950,0.950,0.450) then return true end
    for _,desc in ipairs(part:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible and tonumber(desc.Text:match("%d+")) then return true end
    end
    return false
end

local function isUnrevealed(part)
    if not part or not part:IsA("BasePart") then return false end
    if isExcluded(part) or numberTiles[part] then return false end
    if touchBlacklist[part] then return false end

    local green1=isColorMatch(part.Color,0.459,0.804,0.392)
    local green2=isColorMatch(part.Color,0.404,0.706,0.345)
    local red1  =isColorMatch(part.Color,0.804,0.392,0.392)
    local red2  =isColorMatch(part.Color,0.706,0.345,0.345)
    local blue1 =isColorMatch(part.Color,0.392,0.741,0.804)
    local blue2 =isColorMatch(part.Color,0.345,0.651,0.706)
    if green1 or green2 or red1 or red2 or blue1 or blue2 then return true end

    local r,g,b=part.Color.R,part.Color.G,part.Color.B
    if g>r+0.08 and g>b+0.05 and g>0.30 then return true end
    if r>g+0.15 and r>b+0.15 and r>0.40 then return true end
    if b>r+0.05 and g>r+0.05 and b>0.35 then return true end

    -- snow/grey theme
    local spread=math.max(r,g,b)-math.min(r,g,b)
    if spread<0.12 and r>0.30 and r<0.80 then
        for _,desc in ipairs(part:GetDescendants()) do
            if desc:IsA("SurfaceGui") then return false end
        end
        return true
    end
    return false
end

local function getNumber(part)
    if not part or not part:IsA("BasePart") then return nil end
    for _,desc in ipairs(part:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local num=tonumber(desc.Text:match("%d+"))
            if num and num>=1 and num<=8 then return num end
        end
    end
    return nil
end

local function isTileCandidate(part)
    if not part or not part:IsA("BasePart") then return false end
    if isExcluded(part) and getNumber(part)==nil then return false end
    if numberTiles[part] or isUnrevealed(part) or getNumber(part)~=nil then return true end
    local s=part.Size
    return s.X<8 and s.Z<8 and s.Y<4 and part.Anchored
end

local function refreshFlagCache()
    table.clear(activeFlagPositions)
    local ff=Workspace:FindFirstChild("Flag") or Workspace:FindFirstChild("Flags")
    if ff then
        for _,desc in ipairs(ff:GetDescendants()) do
            if desc:IsA("BasePart") then table.insert(activeFlagPositions,desc.Position) end
        end
    end
    for _,obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and string.find(string.lower(obj.Name),"flag") then
            local pr=obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if pr then table.insert(activeFlagPositions,pr.Position) end
        end
    end
end

local function hasFlag(part)
    if not part or not part:IsDescendantOf(workspace) then return false end
    local pPos=part.Position
    local px=part.Size.X*0.55; local pz=part.Size.Z*0.55
    for _,fPos in ipairs(activeFlagPositions) do
        if math.abs(fPos.X-pPos.X)<px and math.abs(fPos.Z-pPos.Z)<pz then
            local dy=fPos.Y-pPos.Y
            if dy>0.3 and dy<6 then return true end
        end
    end
    return false
end

local function clickTile(part)
    if not part or not part:IsDescendantOf(workspace) then return end
    local cd=part:FindFirstChildOfClass("ClickDetector") or part:FindFirstChildWhichIsA("ClickDetector",true)
    if cd and typeof(fireclickdetector)=="function" then fireclickdetector(cd,0) end
end

local function triggerTileTouch(targetTile)
    if not targetTile or not targetTile:IsDescendantOf(workspace) then return end
    if touchBlacklist[targetTile] then return end
    unmarkTile(targetTile)
    local char=player.Character; if not char then return end
    local limb=char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")
        or char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Leg")
        or char:FindFirstChild("HumanoidRootPart")
    if not limb then return end
    if typeof(firetouchinterest)=="function" then
        firetouchinterest(limb,targetTile,0); task.wait(0.015); firetouchinterest(limb,targetTile,1)
    else
        local probe=Instance.new("Part"); probe.Name="LegProbe"
        probe.Size=limb.Size; probe.CanCollide=false; probe.Transparency=1
        probe.CFrame=targetTile.CFrame; probe.Parent=char
        task.wait(0.02); probe:Destroy()
    end
    task.delay(0.4,function()
        if not targetTile:IsDescendantOf(workspace) then return end
        if isUnrevealed(targetTile) then
            touchBlacklist[targetTile]=true; unmarkTile(targetTile)
        end
    end)
end

local function createHighlight(part,color,name)
    if part:FindFirstChild(name) then return end
    if name=="Guess_Highlight" then
        if part:FindFirstChild("Safe_Highlight") or part:FindFirstChild("Mine_Highlight") then return end
    elseif name=="Safe_Highlight" or name=="Mine_Highlight" then
        local g=part:FindFirstChild("Guess_Highlight"); if g then g:Destroy() end
    end
    local h=Instance.new("Highlight"); h.Name=name; h.Adornee=part
    h.FillColor=color; h.FillTransparency=0.4; h.OutlineTransparency=0.5
    h.DepthMode=Enum.HighlightDepthMode.Occluded; h.Parent=part
end

local function cacheNeighbors(centerPart,forceRefresh)
    if not forceRefresh and neighborMap[centerPart] then return end
    local neighbors={}
    local partsInBox=workspace:GetPartBoundsInBox(centerPart.CFrame,centerPart.Size*2.5)
    for _,p in ipairs(partsInBox) do
        if p~=centerPart and isTileCandidate(p) then
            if math.abs(p.Position.Y-centerPart.Position.Y)<1.5 then
                if (p.Position-centerPart.Position).Magnitude<(centerPart.Size.X*1.85) then
                    table.insert(neighbors,p)
                end
            end
        end
    end
    neighborMap[centerPart]=neighbors
end

-- SURGICAL INVALIDATION: only invalidate tiles that share a neighbor with changedTile
local function invalidateNeighborhood(changedTile)
    -- changedTile just got revealed → its number-tile neighbors need re-eval
    -- strip non-locked state from unrevealed tiles around changedTile's neighbors
    local touched = {}
    -- direct neighbors of changedTile
    for _,nb in ipairs(neighborMap[changedTile] or {}) do
        if not touched[nb] then
            touched[nb] = true
            -- for each unrevealed neighbor of nb that is not locked, clear speculative state
            for _,nb2 in ipairs(neighborMap[nb] or {}) do
                if not lockedSafe[nb2] and not lockedMines[nb2] then
                    if knownSafe[nb2] then clearVisuals(nb2); knownSafe[nb2]=nil end
                    if knownMines[nb2] then clearVisuals(nb2); knownMines[nb2]=nil end
                end
            end
        end
    end
    if currentBestGuess and not currentBestGuess:IsDescendantOf(workspace) then
        clearVisuals(currentBestGuess); currentBestGuess=nil
    end
end

-- legacy requestReset kept for onDescendantAdded path, now surgical
local function requestReset()
    if pendingReset then return end
    pendingReset=true
    task.delay(0.2,function()
        pendingReset=false
        if not isScanning then return end
        for p,_ in pairs(knownSafe) do
            if not lockedSafe[p] then clearVisuals(p); knownSafe[p]=nil end
        end
        for p,_ in pairs(knownMines) do
            if not lockedMines[p] then clearVisuals(p); knownMines[p]=nil end
        end
        if currentBestGuess then clearVisuals(currentBestGuess) end
        currentBestGuess=nil
    end)
end

-------------------------------------------------------------------------------
-- TIER 2: Connected component grouping
-- Two tileData entries are in the same component if their unrevealed sets overlap.
-- Returns list of components, each is a list of tileData entries.
-------------------------------------------------------------------------------
local function buildConnectedComponents(tileDataList)
    local n = #tileDataList
    if n == 0 then return {} end

    -- parent array for union-find
    local parent = {}
    for i = 1, n do parent[i] = i end

    local function find(x)
        while parent[x] ~= x do
            parent[x] = parent[parent[x]]
            x = parent[x]
        end
        return x
    end
    local function union(a, b)
        a = find(a); b = find(b)
        if a ~= b then parent[a] = b end
    end

    -- build a set of unrevealed parts per tileData index for fast overlap check
    local sets = {}
    for i, td in ipairs(tileDataList) do
        local s = {}
        for _, p in ipairs(td.unrevealed) do s[p] = true end
        sets[i] = s
    end

    -- union any two tileData entries that share at least one unrevealed tile
    -- O(n² * avg_unrevealed) — acceptable since n is small (border tiles only)
    for i = 1, n do
        for j = i+1, n do
            if find(i) ~= find(j) then
                for p, _ in pairs(sets[i]) do
                    if sets[j][p] then
                        union(i, j)
                        break
                    end
                end
            end
        end
    end

    -- group by root
    local groups = {}
    local rootToGroup = {}
    for i = 1, n do
        local root = find(i)
        if not rootToGroup[root] then
            rootToGroup[root] = {}
            table.insert(groups, rootToGroup[root])
        end
        table.insert(rootToGroup[root], tileDataList[i])
    end
    return groups
end

