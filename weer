-- SOLVER CORE
-------------------------------------------------------------------------------
local function solveStructural(tileDataList)
    if not isPatternLibEnabled then return end
    for _,tData in ipairs(tileDataList) do
        if tData.remaining < 0 then
            -- over-flagged: safe pass on unrevealed
            for _,p in ipairs(tData.unrevealed) do
                if not knownSafe[p] then markSafe(p) end
            end
        elseif #tData.unrevealed == tData.remaining and tData.remaining > 0 then
            for _,p in ipairs(tData.unrevealed) do
                if not knownMines[p] then markMine(p) end
            end
        elseif tData.remaining == 0 and #tData.unrevealed > 0 then
            for _,p in ipairs(tData.unrevealed) do
                if not knownSafe[p] then markSafe(p) end
            end
        end
    end
end

local function solveSubset(tileDataList)
    if not isPatternLibEnabled then return end
    for i=1,#tileDataList do
        for j=i+1,#tileDataList do
            local t1,t2=tileDataList[i],tileDataList[j]
            -- make sure t1 is the smaller one
            if #t1.unrevealed > #t2.unrevealed then t1,t2=t2,t1 end
            if #t1.unrevealed == 0 then continue end

            local t2Set={}
            for _,p in ipairs(t2.unrevealed) do t2Set[p]=true end
            local isSubset=true
            for _,p in ipairs(t1.unrevealed) do
                if not t2Set[p] then isSubset=false; break end
            end

            if isSubset and #t2.unrevealed > #t1.unrevealed then
                local t1Set={}
                for _,p in ipairs(t1.unrevealed) do t1Set[p]=true end
                local diff={}
                for _,p in ipairs(t2.unrevealed) do
                    if not t1Set[p] then table.insert(diff,p) end
                end
                local diffMines=t2.remaining-t1.remaining
                if diffMines==0 then
                    for _,p in ipairs(diff) do if not knownSafe[p] then markSafe(p) end end
                elseif diffMines==#diff and #diff>0 then
                    for _,p in ipairs(diff) do if not knownMines[p] then markMine(p) end end
                end
            end
        end
    end
end

-- TIER 3: exact enum with early-exit pruning per connected component
local function solveExactComponent(componentTiles)
    -- collect unique unrevealed across this component
    local unrevSet={}; local unrevList={}
    for _,td in ipairs(componentTiles) do
        for _,p in ipairs(td.unrevealed) do
            if not unrevSet[p] then unrevSet[p]=true; table.insert(unrevList,p) end
        end
    end
    if #unrevList==0 or #unrevList>EXACT_ENUM_MAX_SIZE then return end

    -- build tileToConstraints: part → list of tileData that mention it
    -- used for pruning at each assignment step
    local tileToTD = {}
    for _,p in ipairs(unrevList) do tileToTD[p] = {} end
    for _,td in ipairs(componentTiles) do
        for _,p in ipairs(td.unrevealed) do
            table.insert(tileToTD[p], td)
        end
    end

    local validCombinations = 0
    local mineCount = {}
    for _,p in ipairs(unrevList) do mineCount[p] = 0 end

    -- per-tileData running counts during recursion
    local assignedMines  = {}  -- td → count of mines assigned so far in its unrevealed
    local assignedTotal  = {}  -- td → count of tiles assigned so far in its unrevealed
    for _,td in ipairs(componentTiles) do
        assignedMines[td] = 0
        assignedTotal[td] = 0
    end

    local assignment = {}  -- part → true/false (mine/safe)

    local function recurse(idx)
        if idx > #unrevList then
            -- leaf: check all constraints are exactly satisfied
            for _,td in ipairs(componentTiles) do
                if assignedMines[td] ~= td.remaining then return end
            end
            validCombinations = validCombinations + 1
            for _,p in ipairs(unrevList) do
                if assignment[p] then mineCount[p] = mineCount[p] + 1 end
            end
            return
        end

        local part = unrevList[idx]
        local affectedTDs = tileToTD[part]

        for _,isMine in ipairs({false, true}) do
            -- update running counts
            for _,td in ipairs(affectedTDs) do
                assignedTotal[td] = assignedTotal[td] + 1
                if isMine then assignedMines[td] = assignedMines[td] + 1 end
            end
            assignment[part] = isMine

            -- TIER 3 PRUNING: check only constraints affected by this assignment
            local pruned = false
            for _,td in ipairs(affectedTDs) do
                local remaining = td.remaining
                local am = assignedMines[td]
                local at = assignedTotal[td]
                local left = #td.unrevealed - at  -- unassigned tiles left in this constraint
                -- violated: too many mines already, OR not enough tiles left to reach target
                if am > remaining or (am + left) < remaining then
                    pruned = true
                    break
                end
            end

            if not pruned then
                recurse(idx + 1)
            end

            -- undo
            for _,td in ipairs(affectedTDs) do
                assignedTotal[td] = assignedTotal[td] - 1
                if isMine then assignedMines[td] = assignedMines[td] - 1 end
            end
        end
    end

    local ok = pcall(recurse, 1)
    if ok and validCombinations > 0 then
        for _,p in ipairs(unrevList) do
            local prob = mineCount[p] / validCombinations
            if prob == 0 then
                if not knownSafe[p]  then markSafe(p)  end
            elseif prob == 1 then
                if not knownMines[p] then markMine(p) end
            end
        end
    end
end

local function solveAdvanced(tileDataList)
    if not isPatternLibEnabled then return end
    solveSubset(tileDataList)

    -- TIER 2: split into connected components, solve each separately
    local components = buildConnectedComponents(tileDataList)
    for _,comp in ipairs(components) do
        solveExactComponent(comp)
    end
end

-- TIER 1: propagation loop — keeps solving until no new info discovered this cycle
local function runPropagationLoop(tileDataList)
    -- prime the queue with all current number tiles
    table.clear(propagationQueue)
    table.clear(inPropQueue)
    for centerPart,_ in pairs(numberTiles) do
        if centerPart:IsDescendantOf(workspace) and not inPropQueue[centerPart] then
            inPropQueue[centerPart] = true
            table.insert(propagationQueue, centerPart)
        end
    end

    local iterations = 0
    local maxIter = 12  -- safety cap: never spin more than 12 propagation waves

    while #propagationQueue > 0 and iterations < maxIter do
        iterations = iterations + 1
        local wave = propagationQueue
        propagationQueue = {}
        inPropQueue = {}

        -- build tileDataList for tiles in this wave only
        local waveTileData = {}
        for _,centerPart in ipairs(wave) do
            if not centerPart:IsDescendantOf(workspace) then continue end
            local neighbors = neighborMap[centerPart]
            if not neighbors then continue end
            local targetNum = numberTiles[centerPart]
            if not targetNum then continue end

            local unrevealed = {}
            local mc = 0
            for _,n in ipairs(neighbors) do
                if knownMines[n] then
                    mc = mc + 1
                elseif isUnrevealed(n) and not knownSafe[n] then
                    table.insert(unrevealed, n)
                end
            end
            local remaining = targetNum - mc
            -- GUARD: skip if remaining < 0 (over-flagged) or no unrevealed
            if remaining < 0 or #unrevealed == 0 then continue end

            table.insert(waveTileData, {
                tile=centerPart, number=targetNum,
                unrevealed=unrevealed, remaining=remaining
            })
        end

        if #waveTileData == 0 then break end

        -- structural pass on this wave
        solveStructural(waveTileData)
        -- advanced (subset + exact enum per component)
        solveAdvanced(waveTileData)
        -- propagationQueue is now populated by markSafe/markMine calls above
        -- next iteration will process those
    end

    -- return full tileDataList for probability map
    local fullTileData = {}
    for centerPart,targetNum in pairs(numberTiles) do
        if not centerPart:IsDescendantOf(workspace) then continue end
        local neighbors = neighborMap[centerPart]
        if not neighbors then continue end
        local unrevealed={}; local mc=0
        for _,n in ipairs(neighbors) do
            if knownMines[n] then mc=mc+1
            elseif isUnrevealed(n) and not knownSafe[n] then table.insert(unrevealed,n) end
        end
        local remaining=targetNum-mc
        if remaining>=0 and #unrevealed>0 then
            table.insert(fullTileData,{
                tile=centerPart,number=targetNum,
                unrevealed=unrevealed,remaining=remaining
            })
        end
    end
    return fullTileData
end

local function solveBoard()
    if pendingReset then return end
    probabilityMap={}

    local fullTileData = runPropagationLoop({})

    -- build probability map from whatever remains uncertain
    for _,tData in ipairs(fullTileData) do
        if tData.remaining>0 and #tData.unrevealed>0 and tData.remaining<#tData.unrevealed then
            local prob=tData.remaining/#tData.unrevealed
            for _,p in ipairs(tData.unrevealed) do
                if not probabilityMap[p] or prob>probabilityMap[p] then
                    probabilityMap[p]=prob
                end
            end
        end
    end

    -- best guess cleanup
    local hasSafe=false
    for _ in pairs(knownSafe) do hasSafe=true; break end

    if currentBestGuess and (
        not currentBestGuess:IsDescendantOf(workspace)
        or knownSafe[currentBestGuess] or knownMines[currentBestGuess] or hasSafe
    ) then
        if currentBestGuess:IsDescendantOf(workspace) then
            local h=currentBestGuess:FindFirstChild("Guess_Highlight"); if h then h:Destroy() end
        end
        currentBestGuess=nil
    end

    if not hasSafe then
        local best=nil; local low=1.1
        for part,prob in pairs(probabilityMap) do
            if not knownMines[part] and not knownSafe[part] then
                if prob<low then low=prob; best=part end
            end
        end
        if best and best~=currentBestGuess then
            if currentBestGuess and currentBestGuess:IsDescendantOf(workspace) then
                local h=currentBestGuess:FindFirstChild("Guess_Highlight"); if h then h:Destroy() end
            end
            currentBestGuess=best
            createHighlight(best,Color3.fromRGB(0,100,255),"Guess_Highlight")
        end
    end
end

local function startSolverLoop()
    task.spawn(function()
        while isScanning do
            local validParts={}
            local charPos=getCharPos()
            for _,part in ipairs(cachedParts) do
                if part and part:IsDescendantOf(workspace) then
                    if isExcluded(part) then
                        -- tile revealed → surgical invalidation then update numberTiles
                        if knownSafe[part] or knownMines[part] or lockedSafe[part] or lockedMines[part] then
                            invalidateNeighborhood(part)
                        end
                        unmarkTile(part)
                        numberTiles[part]=getNumber(part)
                        -- re-queue number tile neighbors for propagation
                        if numberTiles[part] and neighborMap[part] then
                            for _,nb in ipairs(neighborMap[part]) do
                                if numberTiles[nb] and not inPropQueue[nb] then
                                    inPropQueue[nb]=true; table.insert(propagationQueue,nb)
                                end
                            end
                        end
                        continue
                    end
                    table.insert(validParts,part)
                    if maxDistance>0 and charPos then
                        if (part.Position-charPos).Magnitude>maxDistance then
                            if not lockedSafe[part] and not lockedMines[part] then
                                clearVisuals(part); numberTiles[part]=nil
                                knownSafe[part]=nil; knownMines[part]=nil
                            end
                            continue
                        end
                    end
                    if not neighborMap[part] then cacheNeighbors(part,false) end
                    local num=getNumber(part)
                    if num then numberTiles[part]=num
                    elseif isExcluded(part) then numberTiles[part]=nil end
                else
                    neighborMap[part]=nil; numberTiles[part]=nil
                    knownMines[part]=nil; knownSafe[part]=nil
                    lockedSafe[part]=nil; lockedMines[part]=nil
                    touchBlacklist[part]=nil
                end
            end
            cachedParts=validParts
            solveBoard()
            task.wait(0.12)
        end
    end)
end

local function onDescendantAdded(descendant)
    if isScanning and isTileCandidate(descendant) then
        table.insert(cachedParts,descendant)
        task.delay(0.1,function()
            if descendant:IsDescendantOf(workspace) then
                cacheNeighbors(descendant,true)
                for _,nb in ipairs(neighborMap[descendant] or {}) do
                    cacheNeighbors(nb,true)
                end
                requestReset()
            end
        end)
    end
end

